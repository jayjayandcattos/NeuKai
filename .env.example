# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------
APP_ENV=local
APP_URL=http://localhost/Neukai

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neukai
DB_USER=root
DB_PASS=

# Outgoing mail (Gmail app password, NOT the account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=smtps
MAIL_USERNAME=neukai.organization@gmail.com
MAIL_PASSWORD=replace-with-a-new-app-password
MAIL_FROM=neukai.organization@gmail.com
MAIL_FROM_NAME="Neukai Team"
